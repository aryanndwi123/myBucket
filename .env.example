NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/mybucket?retryWrites=true&w=majority

OPENAI_API_KEY=
OPENAI_CLASSIFY_MODEL=gpt-4o-mini

# Transcription runs on Groq's OpenAI-compatible API (cheaper/faster for audio).
TRANSCRIBE_API_KEY=gsk_replace_with_real_groq_key
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Path to the yt-dlp binary. Local dev: "yt-dlp" (on PATH via brew/pip).
# Render: "./bin/yt-dlp" — the build command downloads it there, and it's
# not on PATH, so the bare "yt-dlp" default silently fails with ENOENT.
YTDLP_PATH=yt-dlp
# Dir with the ffmpeg binary, passed to yt-dlp as --ffmpeg-location. Needed
# so yt-dlp can remux Instagram's combined video+audio fallback stream into
# something with a readable audio track. Local dev: leave empty (on PATH).
# Render: the dir the build command extracts ffmpeg into, e.g. "./bin".
FFMPEG_LOCATION=
REEL_PROCESSING_TIMEOUT_MS=30000

# Signs the session JWT issued after username/password login.
JWT_SECRET=

# Max non-Inbox folders per user before new items fall back to Inbox.
FOLDER_CAP=8
