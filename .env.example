OPENAI_API_KEY=
OPENAI_CLASSIFY_MODEL=gpt-4o-mini

# Transcription runs on Groq's OpenAI-compatible API (cheaper/faster for audio).
TRANSCRIBE_API_KEY=gsk_replace_with_real_groq_key
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Path to the yt-dlp binary. Defaults to "yt-dlp" (must be on PATH).
YTDLP_PATH=yt-dlp
REEL_PROCESSING_TIMEOUT_MS=30000

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
