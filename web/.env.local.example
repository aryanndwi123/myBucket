# Server-side only: where Next.js proxies /api and /mcp to (see next.config.ts).
# Keeps the session cookie first-party even when the frontend and backend are on different domains.
API_URL=http://localhost:4000

# Only set this if you want the browser to call the backend directly instead of through the proxy
# (then the backend's session cookie must be SameSite=None; Secure, since it'd be cross-origin).
# NEXT_PUBLIC_API_URL=
